  <a href="#contact">联系</a>
</div>

<!-- Hero：LaserFlow 激光流光背景 -->
<section class="hero" id="home">
  <div class="hero-bg" id="heroBg">
    <canvas id="laserCanvas"></canvas>
  </div>
  <div class="hero-vignette"></div>
  <div class="wrap hero-inner">
    <div class="hero-kicker">Shoot It — Remember It Longer</div>
    <h1 class="hero-name" aria-label="拍下来 会记得更久一些">
      <span class="ln"><span>拍</span><span>下</span><span>来</span></span>
      <span class="ln"><span>会</span><span>记</span><span>得</span><span>更</span><span>久</span><span>一</span><span>些</span></span>
    </h1>
    <div class="hero-meta">
      <span class="hm">写真 <b>PORTRAIT</b></span>
      <span class="hm">Cosplay <b>COS</b></span>
      <span class="hm">街拍 <b>STREET</b></span>
      <span class="hm">风景 <b>LANDSCAPE</b></span>
      <span class="hm">动物 <b>ANIMAL</b></span>
    </div>
    <p class="hero-tagline">影像会替你记得——每一次快门，都是把瞬间变成永恒。专注写真、Cosplay 与街拍，为每一帧注入情绪与光。</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#works">查看作品</a>
      <a class="btn btn-ghost" href="#about">关于我</a>
    </div>
  </div>
  <div class="hero-scroll">Scroll<i></i></div>
</section>

<!-- 跑马灯 -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track" id="marqueeTrack">
    <span>写真</span><span>PORTRAIT</span><span>Cosplay</span><span>街拍</span><span>STREET</span>
    <span>风景</span><span>LANDSCAPE</span><span>动物</span><span>ANIMAL</span>
    <span>情绪光影</span><span>高级感影像</span><span>SHOOT IT LONGER</span>
  </div>
</div>

<!-- 关于 -->
<section class="sec-pad" id="about">
  <div class="wrap about-grid">
    <div class="about-photo reveal">
      <div class="frame" id="aboutFrame">
        <img id="aboutImg" src="assets/img/about-camera.jpg" alt="摄影师工作照"
             data-pal="about" data-num="01" data-w="1000" data-h="1300" onerror="phFallback(this)">
      </div>
    </div>
    <div class="about-bio">
      <div class="sec-eyebrow reveal">About / 关于我</div>
      <h2 class="sec-title reveal d1">你好，我是Lin.G</h2>
      <p class="lead reveal d2">一位热衷于捕捉<b>情绪与故事</b>的摄影爱好者，在<b>写真、Cosplay 与街拍</b>之间自由穿行。相信好照片不只是按下快门，更是一次与光、与人的真诚对话。</p>
      <p class="reveal d2">从城市街头的人海，到棚内精心营造的光影，我始终追求「自然、有温度、有记忆点」的影像语言。擅长利用环境光与氛围感，让人物在镜头前呈现最松弛、最真实的自己。</p>
      <p class="reveal d2">无论你是想拍一组情绪写真、还原一个心爱的角色，还是想要一组有电影感的街拍，我都乐于与你一起完成这场创作。</p>
      <div class="stats">
        <div class="stat reveal"><b><span class="count" data-count="300">0</span><i>+</i></b><span>作品产出</span></div>
      </div>
      <div class="signature reveal">— Lin.G</div>
    </div>
  </div>
</section>

<!-- 作品集 -->
<section class="sec-pad" id="works" style="padding-top:0">
  <div class="wrap">
    <div class="works-head">
      <div>
        <div class="sec-eyebrow reveal">Portfolio / 作品集</div>
        <h2 class="sec-title reveal d1">精选作品</h2>
      </div>
            <div class="filters reveal d2" id="filters"><!-- JS 生成 --></div>
    </div>
    <div class="wall-stage" id="worksGrid"></div>
  </div>
</section>

